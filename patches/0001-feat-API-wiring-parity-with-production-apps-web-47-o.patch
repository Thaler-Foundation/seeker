+function LiquidationAnalysis({ vault, pos }: { vault: VaultSummary; pos?: VaultPositions }) {
+  const netApy = (pos?.apyBps ?? vault.metrics?.apyBps ?? 0) / 100;
+  const { prices: liqPrices } = usePythPrices();
+  const liqSolPrice = liqPrices.solana?.price ?? 0;
+  const liqPendingUsd =
+    (pos as { pendingRecycleUsd?: number | null } | undefined)?.pendingRecycleUsd ?? 0;
+  // Same Net Value definition as the My Vaults list: deposit + realized SOL +
+  // the unswapped USDC leg repriced to SOL at the LIVE price.
+  const netValueSol =
+    (pos?.equityNavLamports
+      ? Number(lamportsToSol(pos.equityNavLamports))
+      : Number(vault.equityLamports) / LAMPORTS) +
+    (liqSolPrice > 0 && liqPendingUsd > 0 ? liqPendingUsd / liqSolPrice : 0);
+
+  // Vault Health = the Kamino Multiply leg's net carry APY (bps); Short Hedge =
+  // the active upside-borrow count. Both render as labels only (no %, no count),
+  // per spec. Narrow-cast reads the fields the API now returns until the SDK
+  // type catches up with the positions-backend change.
+  const netCarryApyBps = (
+    pos?.positions?.kaminoMultiply as { netCarryApyBps?: number } | null | undefined
+  )?.netCarryApyBps;
+  const activeUpsideBorrowCount = (pos as { activeUpsideBorrowCount?: number } | undefined)
+    ?.activeUpsideBorrowCount;
+
+  // SAFE if net carry > 1% (100 bps), CAUTION 0..1%, STRESS negative.
+  const vaultHealth =
+    netCarryApyBps == null
+      ? null
+      : netCarryApyBps > 100
+        ? 'SAFE'
+        : netCarryApyBps >= 0
+          ? 'CAUTION'
+          : 'STRESS';
+  // SAFE with no active upside borrow, CAUTION at 1, STRESS at 2 or more.
+  const shortHedge =
+    activeUpsideBorrowCount == null
+      ? null
+      : activeUpsideBorrowCount <= 0
+        ? 'SAFE'
+        : activeUpsideBorrowCount === 1
+          ? 'CAUTION'
+          : 'STRESS';
